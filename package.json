{
  "name": "officedays",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "dev": "vite build && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply officedays --local",
    "db:migrate:remote": "wrangler d1 migrations apply officedays --remote",
    "deploy": "vite build && wrangler pages deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.4",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7",
    "wrangler": "^4.149.0"
  }
}
